<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  body { font-family: Helvetica, Arial, sans-serif; color: #111827; margin: 32px; font-size: 11pt; }
  h1 { font-size: 18pt; border-bottom: 2px solid #0e7490; padding-bottom: 6px; }
  .meta { color: #6b7280; font-size: 9pt; margin-bottom: 20px; }
  .kpis { width: 100%; margin: 16px 0 24px 0; border-collapse: collapse; }
  .kpis td { border: 1px solid #d1d5db; padding: 10px; text-align: center; }
  .kpis .num { font-size: 16pt; font-weight: bold; display: block; }
  table.iocs { width: 100%; border-collapse: collapse; font-size: 9pt; }
  table.iocs th { background: #f3f4f6; text-align: left; padding: 6px 8px; border: 1px solid #d1d5db; }
  table.iocs td { padding: 5px 8px; border: 1px solid #e5e7eb; font-family: monospace; }
  td.sev-critical { color: #dc2626; font-weight: bold; }
  td.sev-high { color: #ea580c; font-weight: bold; }
  td.sev-medium { color: #d97706; }
  td.sev-low { color: #16a34a; }
  td.sev-info { color: #64748b; }
  .footer { margin-top: 28px; color: #9ca3af; font-size: 8pt; }
</style>
</head>
<body>
<h1>ThreatIntelHub {{ kind }} Report</h1>
<div class="meta">Period: {{ period_start }} &rarr; {{ period_end }} &middot; Generated: {{ generated_at }}</div>

<table class="kpis">
  <tr>
    <td><span class="num">{{ kpis.total_iocs }}</span>Total IOCs</td>
    <td><span class="num" style="color:#dc2626">{{ kpis.critical }}</span>Critical</td>
    <td><span class="num" style="color:#ea580c">{{ kpis.high }}</span>High</td>
    <td><span class="num" style="color:#d97706">{{ kpis.medium }}</span>Medium</td>
    <td><span class="num" style="color:#16a34a">{{ kpis.low }}</span>Low</td>
    <td><span class="num" style="color:#64748b">{{ kpis.info }}</span>Info</td>
  </tr>
</table>

<h2>Top IOCs by score</h2>
<table class="iocs">
  <tr><th>Score</th><th>Severity</th><th>Type</th><th>Value</th><th>Sources</th><th>Last seen</th></tr>
  {% for i in iocs %}
  <tr>
    <td>{{ i.threat_score }}</td>
    <td class="sev-{{ i.severity }}">{{ i.severity }}</td>
    <td>{{ i.type }}</td>
    <td>{{ i.value_norm }}</td>
    <td>{{ i.sources | join(', ') }}</td>
    <td>{{ i.last_seen }}</td>
  </tr>
  {% else %}
  <tr><td colspan="6">No IOCs recorded in this period.</td></tr>
  {% endfor %}
</table>

<div class="footer">
  Generated by ThreatIntelHub &mdash; automated threat intelligence aggregation.
  VirusTotal data used under non-commercial free-tier terms.
</div>
</body>
</html>
