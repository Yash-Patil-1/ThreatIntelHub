# ── Required ────────────────────────────────────────────────────────────────
# Postgres (compose default matches the pg service below)
DATABASE_URL=postgresql+asyncpg://tih:tih@pg:5432/tih
POSTGRES_USER=tih
POSTGRES_PASSWORD=tih
POSTGRES_DB=tih

# Redis
REDIS_URL=redis://redis:6379/0

# Fernet master key for encrypting feed API keys at rest (32-byte urlsafe base64)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"


# Session-cookie signing secret (random 64 hex chars)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Fernet key for settings API-key encryption at rest (auto-generated into .env on boot if empty)
SETTINGS_FERNET_KEY=

# First-boot admin seed (missing → warn + skip seeding)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ── Optional — per-source API keys (free tiers) ────────────────────────────
# App boots with zero keys; unkeyed sources show "disabled" in health/UI.
OTX_API_KEY=
VIRUSTOTAL_API_KEY=          # 4/min, 500/day — NON-COMMERCIAL USE ONLY
ABUSEIPDB_API_KEY=           # 1000 checks/day, 5 blacklist/day
SHODAN_API_KEY=              # host lookup only (~1 req/s); search never called

# ── Optional — tuning / ops ────────────────────────────────────────────────
APP_ENV=production           # development enables verbose errors + SQL echo
LOG_LEVEL=INFO
TZ=UTC
CORS_ORIGINS=http://localhost:3000
DATA_DIR=/data

# Scheduler crons (UTC)
INGEST_OTX_CRON=0 * * * *
INGEST_AIPDB_CRON=0 4 * * *
RESCORE_SWEEP_CRON=0 3 * * *
REPORT_DAILY_CRON=30 6 * * *

# Enrichment TTL escape hatches (hours; defaults already quota-safe)
ENRICH_TTL_VT_HOURS=24
ENRICH_TTL_AIPDB_HOURS=12
ENRICH_TTL_SHODAN_HOURS=6
ENRICH_TTL_INTERNETDB_HOURS=6
ENRICH_TTL_OTX_HOURS=12
